// Sign-ins to the Altiward console (with the role given) and sign-outs: single sign-on, and each hour a console token is used (the break-glass login).
// Tags: altiward
AltiwardOCSF_CL
| where ClassUid == 3002 and tostring(Ocsf.service.name) == "Altiward console"
| project TimeGenerated, UserName, Activity = tostring(Ocsf.activity_name), Message
| order by TimeGenerated desc
